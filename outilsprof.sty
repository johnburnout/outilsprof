% ============================================================
% BOÎTE CALCUL
% Commande avec 2 arguments optionnels + contenu obligatoire
% Par défaut : largeur = 10cm, hauteur = 3cm
% ============================================================
\NewDocumentCommand{\boitecalcul}{O{10cm} O{3cm} +m}{%
    \begin{tcolorbox}[
        colback=white,
        colframe=gray!30,
        arc=3pt,
        boxrule=0.5pt,
        width=#1,
        height=#2,
        valign=center,
        halign=center
    ]
        #3
    \end{tcolorbox}%
}

% ============================================================
% VARIANTES AVEC ENVIRONNEMENTS (pour compatibilité)
% ============================================================

% Environnement retenir (bleu par défaut)
\NewDocumentEnvironment{retenir}{O{couleurRetenir}}{%
    \begin{tcolorbox}[
        colback=#1!10,
        colframe=#1,
        coltitle=white,
        fonttitle=\bfseries,
        arc=4pt,
        boxrule=1pt,
        title={\textbf{À retenir absolument}},
        top=3mm, bottom=3mm, left=3mm, right=3mm
    ]
}{%
    \end{tcolorbox}%
}

% Environnement vigilance (rouge par défaut)
